{
  "name": "pinocchio-cli",
  "version": "0.1.0",
  "description": "Checks your coding agent's \"done, all tests pass\" against the commands it actually ran.",
  "type": "module",
  "bin": {
    "pinocchio": "dist/cli.js",
    "pinocchio-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p test",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "claude-code",
    "codex",
    "coding-agent",
    "hooks",
    "testing",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosehgal/pinocchio.git"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "author": "Rohit Sehgal",
  "homepage": "https://github.com/rosehgal/pinocchio#readme",
  "bugs": {
    "url": "https://github.com/rosehgal/pinocchio/issues"
  }
}
